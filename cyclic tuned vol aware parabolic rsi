// Function to calculate dynamic lower and upper bounds (db, ub)
calc_bands(bool condition,float srcSeries, int memory, float level) =>
    float lmax = -999999.0
    float lmin = 999999.0
    
    // Find min and max over cyclic memory
    for i = 0 to memory - 1 by 1
        float val = nz(srcSeries[i])
        if val > lmax
            lmax := val
        if val < lmin
            lmin := val

    float mstep = (lmax - lmin) / 100.0
    float aperc = level / 100.0

    // Lower Band (db)
    float db = 0.0
    for steps = 0 to 100 by 1
        float testvalue = lmin + mstep * steps
        int below = 0
        for m = 0 to memory - 1 by 1
            below := below + (nz(srcSeries[m]) < testvalue ? 1 : 0)
        float ratio = below / memory
        if ratio >= aperc
            db := testvalue
            break

    // Upper Band (ub)
    float ub = 0.0
    for steps = 0 to 100 by 1
        float testvalue = lmax - mstep * steps
        int above = 0
        for m = 0 to memory - 1 by 1
            above := above + (nz(srcSeries[m]) >= testvalue ? 1 : 0)
        float ratio = above / memory
        if ratio >= aperc
            ub := testvalue
            break
    //if condition  
    //    [srcSeries,srcSeries]
    //else 
    [db, ub]
    
    


