// Manual Override / Fine-Tuning Parameters
bool  use_manual  = input.bool(false, "Override Auto-Calibration?")
float kappa_in    = input.float(2.0, "Kappa (Mean Reversion Speed)", minval=0.1)
float xi_in       = input.float(0.3, "Xi (Vol-of-Vol)", minval=0.01)
float rho_in      = input.float(-0.7, "Rho (Return-Vol Correlation)", minval=-1.0, maxval=1.0)


// ==========================================
// Parameter Auto-Calibration Engine
// ==========================================
// 1. Log returns
float ret = math.log(close / close[1])

// 2. Initial Variance v0 (annualized standard deviation squared, standardizing dt=1 day = 1/252)
float dt = 1.0 / 252.0
float sample_var = ta.variance(ret, hist_length) / dt
float v0 = math.max(sample_var, 0.0001)

// 3. Long-Term Variance Theta
float long_var = ta.variance(ret, long_length) / dt
float theta = use_manual ? (0.20 * 0.20) : math.max(long_var, 0.0001)

// 4. Drift (Mu) & Vol-of-Vol (Xi) estimations
float mu    = ta.sma(ret, hist_length) / dt
float xi    = use_manual ? xi_in : math.sqrt(ta.variance(ta.change(math.sqrt(sample_var)), hist_length) / dt)
float kappa = use_manual ? kappa_in : 2.0
float rho   = use_manual ? rho_in : -0.5

// Current Spot Volatility (Annualized Percentage)
float current_spot_vol = math.sqrt(v0) * 100
float long_term_vol    = math.sqrt(theta) * 100

// ==========================================
// Heston Volatility Horizon Forecast
// ==========================================
// Forward Mean-Reverting Expected Variance: E[v_t] = theta + (v0 - theta) * exp(-kappa * t)
float expected_future_var = theta + (v0 - theta) * math.exp(-kappa * (forecast_steps * dt))
float expected_future_vol = math.sqrt(math.max(expected_future_var, 0)) * 100

// Variance of Variance Approximation for Upper/Lower Volatility Bands
float var_of_var = (v0 * (xi * xi) / kappa) * (math.exp(-kappa * forecast_steps * dt) - math.exp(-2 * kappa * forecast_steps * dt)) + (theta * (xi * xi) / (2 * kappa)) * math.pow(1 - math.exp(-kappa * forecast_steps * dt), 2)

float vol_std_dev = math.sqrt(math.max(var_of_var, 0)) * 100
float upper_band  = expected_future_vol + 2*vol_std_dev
float lower_band  = math.max(expected_future_vol - 2*vol_std_dev, 0)

